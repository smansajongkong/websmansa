    <!-- JAVASCRIPT LOGIC & LOCALSTORAGE PERSISTENCE -->
    <script>
        let isAdmin = false;
        let currentEditingImgTarget = null;

        // Inisialisasi saat Halaman Dimuat
        document.addEventListener('DOMContentLoaded', () => {
            loadSavedData();
        });

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // Modal Login Handlers
        function openLoginModal() {
            document.getElementById('login-modal').classList.remove('hidden');
        }
        function closeLoginModal() {
            document.getElementById('login-modal').classList.add('hidden');
        }

        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('username').value.trim();
            const p = document.getElementById('password').value.trim();

            if (u === 'admin' && p === 'admin123') {
                isAdmin = true;
                closeLoginModal();
                enableAdminMode();
                showNotification('Login Berhasil! Anda berada dalam Mode Admin.');
            } else {
                showNotification('Username atau Password salah! (Default: admin / admin123)');
            }
        }

        function enableAdminMode() {
            document.getElementById('admin-bar').classList.remove('hidden');
            document.getElementById('logo-edit-overlay').classList.remove('hidden');
            document.getElementById('btn-edit-hero-img').classList.remove('hidden');
            document.getElementById('btn-add-prestasi').classList.remove('hidden');
            document.getElementById('btn-add-eskul').classList.remove('hidden');
            document.getElementById('btn-add-berita').classList.remove('hidden');
            document.getElementById('btn-add-galeri').classList.remove('hidden');

            // Aktifkan Kontrol Kartu
            document.querySelectorAll('.admin-card-controls').forEach(el => el.classList.remove('hidden'));

            // Aktifkan Edit Teks Langsung
            document.querySelectorAll('.editable').forEach(el => {
                el.contentEditable = "true";
                el.classList.add('editable-active');
            });
        }

        function logoutAdmin() {
            isAdmin = false;
            document.getElementById('admin-bar').classList.add('hidden');
            document.getElementById('logo-edit-overlay').classList.add('hidden');
            document.getElementById('btn-edit-hero-img').classList.add('hidden');
            document.getElementById('btn-add-prestasi').classList.add('hidden');
            document.getElementById('btn-add-eskul').classList.add('hidden');
            document.getElementById('btn-add-berita').classList.add('hidden');
            document.getElementById('btn-add-galeri').classList.add('hidden');

            document.querySelectorAll('.admin-card-controls').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.editable').forEach(el => {
                el.contentEditable = "false";
                el.classList.remove('editable-active');
            });

            showNotification('Mode Admin Ditutup.');
        }

        // Logo Click Handler
        function handleLogoClick() {
            if (isAdmin) {
                openImgModal('site-logo');
            }
        }

        // Change Image Dialog
        function changeImage(targetId) {
            openImgModal(targetId);
        }

        function openImgModal(target) {
            currentEditingImgTarget = target;
            document.getElementById('inp-file-img').value = '';
            document.getElementById('inp-url-img').value = '';
            document.getElementById('img-modal').classList.remove('hidden');
        }

        function closeImgModal() {
            document.getElementById('img-modal').classList.add('hidden');
        }

        function applyImageChange() {
            const fileInp = document.getElementById('inp-file-img');
            const urlInp = document.getElementById('inp-url-img').value.trim();

            if (fileInp.files && fileInp.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    setImgSrc(currentEditingImgTarget, e.target.result);
                    closeImgModal();
                };
                reader.readAsDataURL(fileInp.files[0]);
            } else if (urlInp) {
                setImgSrc(currentEditingImgTarget, urlInp);
                closeImgModal();
            } else {
                showNotification('Pilih file gambar atau masukkan URL gambar!');
            }
        }

        function setImgSrc(target, src) {
            if (typeof target === 'string') {
                const el = document.getElementById(target);
                if (el) el.src = src;
                if (target === 'site-logo') {
                    const foot = document.getElementById('footer-logo');
                    if (foot) foot.src = src;
                }
            } else if (target instanceof HTMLElement) {
                target.src = src;
            }
        }

        // Card Operations
        function editCardImg(btn) {
            const card = btn.closest('.prestasi-card, .eskul-card, .berita-card, .galeri-card');
            const img = card.querySelector('img');
            currentEditingImgTarget = img;
            openImgModal(img);
        }

        function deleteCard(btn) {
            const card = btn.closest('.prestasi-card, .eskul-card, .berita-card, .galeri-card');
            card.remove();
        }

