        function saveSosmedLinks() {
            const fb = document.getElementById('inp-url-facebook').value.trim();
            const ig = document.getElementById('inp-url-instagram').value.trim();
            const yt = document.getElementById('inp-url-youtube').value.trim();
            const tt = document.getElementById('inp-url-tiktok').value.trim();
