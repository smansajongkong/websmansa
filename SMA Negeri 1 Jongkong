        // Persistensi Data (localStorage)
        function saveAllChanges() {
            const data = {
                textData: {},
                imgSources: {},
                containers: {
                    prestasi: document.getElementById('prestasi-container').innerHTML,
                    eskul: document.getElementById('eskul-container').innerHTML,
                    berita: document.getElementById('berita-container').innerHTML,
                    galeri: document.getElementById('galeri-container').innerHTML
                },
                sosmed: {
                    fb: document.getElementById('top-link-facebook').href,
                    ig: document.getElementById('top-link-instagram').href,
                    yt: document.getElementById('top-link-youtube').href,
                    tt: document.getElementById('top-link-tiktok').href,
                    wa: document.getElementById('top-link-whatsapp').href
                }
            };

            document.querySelectorAll('.editable').forEach((el) => {
                if (el.id) data.textData[el.id] = el.innerHTML;
            });

            document.querySelectorAll('img').forEach((img) => {
                if (img.id) data.imgSources[img.id] = img.src;
            });

            localStorage.setItem('sman1_jongkong_webdata', JSON.stringify(data));
            showNotification('Semua perubahan berhasil disimpan secara permanen!');
        }

        function loadSavedData() {
            const saved = localStorage.getItem('sman1_jongkong_webdata');
            if (!saved) return;

            try {
                const data = JSON.parse(saved);

                if (data.textData) {
                    Object.keys(data.textData).forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.innerHTML = data.textData[id];
                    });
                }

                if (data.imgSources) {
                    Object.keys(data.imgSources).forEach(id => {
                        const img = document.getElementById(id);
                        if (img) img.src = data.imgSources[id];
                    });
                }

                if (data.containers) {
                    if (data.containers.prestasi) document.getElementById('prestasi-container').innerHTML = data.containers.prestasi;
                    if (data.containers.eskul) document.getElementById('eskul-container').innerHTML = data.containers.eskul;
                    if (data.containers.berita) document.getElementById('berita-container').innerHTML = data.containers.berita;
                    if (data.containers.galeri) document.getElementById('galeri-container').innerHTML = data.containers.galeri;
                }

                if (data.sosmed) {
                    if (data.sosmed.fb) { document.getElementById('top-link-facebook').href = data.sosmed.fb; document.getElementById('foot-link-facebook').href = data.sosmed.fb; }
                    if (data.sosmed.ig) { document.getElementById('top-link-instagram').href = data.sosmed.ig; document.getElementById('foot-link-instagram').href = data.sosmed.ig; }
                    if (data.sosmed.yt) { document.getElementById('top-link-youtube').href = data.sosmed.yt; document.getElementById('foot-link-youtube').href = data.sosmed.yt; }
                    if (data.sosmed.tt) { document.getElementById('top-link-tiktok').href = data.sosmed.tt; document.getElementById('foot-link-tiktok').href = data.sosmed.tt; }
                    if (data.sosmed.wa) { document.getElementById('top-link-whatsapp').href = data.sosmed.wa; }
                }
            } catch (e) {
                console.error("Gagal memuat data tersimpan:", e);
            }
        }

        // Custom Notification Box
        function showNotification(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 z-50 bg-slate-900 text-amber-400 px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold border border-amber-500/30 flex items-center gap-2 animate-bounce';
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-amber-400"></i> ${msg}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }
    </script>
